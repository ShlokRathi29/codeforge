# ==========================================
# Server Configuration
# ==========================================
PORT=8000
ENVIRONMENT=development
DEBUG=True

# ==========================================
# Security Secrets
# ==========================================
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ==========================================
# Database Configuration (SQLite)
# ==========================================
DATABASE_URL=sqlite:///./hackathon.db

# ==========================================
# CORS Configuration
# Comma-separated allowed origins or * for all
# Any *.onrender.com frontend domain is also supported automatically
# ==========================================
CORS_ORIGINS=https://codeforge-0j8e.onrender.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# AI Provider API Keys
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_groq_api_key_here

# ==========================================
# Google OAuth Configuration
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_google_project_id_here
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/google/callback
