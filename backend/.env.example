# ==========================================
# Server Configuration
# ==========================================
PORT=8000
ENVIRONMENT=development
DEBUG=True

# ==========================================
# Security Secrets
# ==========================================
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ==========================================
# Database Configuration (SQLite)
# ==========================================
DATABASE_URL=sqlite:///./hackathon.db

# ==========================================
# CORS Configuration
# Comma-separated allowed origins or * for all
# Any *.onrender.com frontend domain is also supported automatically
# ==========================================
CORS_ORIGINS=https://codeforge-0j8e.onrender.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
